# ─────────────────────────────────────────────────────────────
# NETRA environment configuration
# Copy this file to `.env` for local development. Live records and intelligence
# require the deployed Catalyst Function; credentials belong in that Function's
# console configuration and must never be committed.
# ─────────────────────────────────────────────────────────────

# Session signing secret (any random string). A default is used if unset.
NETRA_SESSION_SECRET=change-me-to-a-long-random-string

# AI backend: Zoho Catalyst QuickML + Zia
# NETRA uses NO external AI (no OpenAI / Gemini / Ollama). In production
# every AI call goes to Zoho Catalyst QuickML (LLM + RAG) and Zia (voice).
# The browser calls a Catalyst Function; its QuickML credentials remain in the
# Function configuration and must never be committed to the frontend project.
QML_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
QML_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
QML_REFRESH_TOKEN=YOUR_OAUTH_REFRESH_TOKEN
QML_ORG=YOUR_ORG_ID
QML_PROJECT_ID=YOUR_PROJECT_ID
QML_ACCOUNTS_BASE=https://accounts.zoho.in
QML_DC_BASE=https://api.catalyst.zoho.in
QML_AUTH_SCHEME=Zoho-oauthtoken
QML_LLM_PATH=llm/chat
# Published text-only LLM Serving endpoint key (Function configuration only).
QML_LLM_ENDPOINT_KEY=
QML_LLM_ENDPOINT_PATH=endpoints/predict
DATASTORE_TABLES=State,District,UnitType,Unit,Rank,Designation,Employee,CaseCategory,GravityOffence,CaseStatusMaster,CasteMaster,ReligionMaster,OccupationMaster,Court,Act,Section,CrimeHead,CrimeSubHead,CrimeHeadActSection,CaseMaster,ComplainantDetails,Victim,Accused,ActSectionAssociation,Inv_OccuranceTime,ArrestSurrender,inv_arrestsurrenderaccused,ChargesheetDetails,Evidence,Notifications,OcrResult
STRATUS_BUCKET=ksp-netra
# Optional: route document/report originals to a pre-created private Catalyst
# FileStore folder. Library metadata and OCR text still use STRATUS_BUCKET.
# Leave empty to use the existing private Stratus bucket for originals too.
NETRA_FILESTORE_FOLDER_ID=
EVIDENCE_TABLE=Evidence
REQUIRE_CATALYST_AUTH=false

# Optional only for Catalyst data centers where Zia AutoML is available.
# The KspHacks project is in the India data center, where AutoML is unavailable.
AUTOML_MODEL_ID=

# This public Function URL is embedded in the frontend at build time.
NEXT_PUBLIC_AI_FN_URL=https://YOUR_PROJECT.catalystserverless.in/server/ai_quickml/

# Optional redirect target for Slate/non-Catalyst hosts. Omit for the KspHacks
# production Web Client configured in source.
NEXT_PUBLIC_CATALYST_APP_ORIGIN=https://YOUR_PROJECT.catalystserverless.in
