# ─────────────────────────────────────────────────────────────
# NETRA — environment configuration
# Copy this file to `.env` (values below are safe local defaults).
# The app runs fully WITHOUT any of these set — they only enable the
# Zoho Catalyst AI backend. With none set, NETRA falls back to its
# built-in deterministic reasoning engine so it works on any laptop.
# ─────────────────────────────────────────────────────────────

# Session signing secret (any random string). A default is used if unset.
NETRA_SESSION_SECRET=change-me-to-a-long-random-string

# ── AI backend: Zoho Catalyst QuickML + Zia (the ONLY AI product) ──
# NETRA uses NO external AI (no OpenAI / Gemini / Ollama). In production
# every AI call goes to Zoho Catalyst QuickML (LLM + RAG) and Zia (voice).
# The browser calls a Catalyst Function; its QuickML credentials remain in the
# Function configuration and must never be committed to the frontend project.
QML_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
QML_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
QML_REFRESH_TOKEN=YOUR_OAUTH_REFRESH_TOKEN
QML_ORG=YOUR_ORG_ID
QML_PROJECT_ID=YOUR_PROJECT_ID
QML_ACCOUNTS_BASE=https://accounts.zoho.in
QML_DC_BASE=https://api.catalyst.zoho.in
QML_AUTH_SCHEME=Zoho-oauthtoken
QML_LLM_PATH=llm/chat
DATASTORE_TABLES=Firs,Cases,Criminals,FirCriminals,Arrests,Victims,Complainants,Evidence,Relationships,Phones,Vehicles,Addresses,Organizations,OrgMembers,AuditLogs,Notifications,PoliceStations,Chargesheets
STRATUS_BUCKET=ksp-netra
EVIDENCE_TABLE=Evidence
REQUIRE_CATALYST_AUTH=false

# Optional only for Catalyst data centers where Zia AutoML is available.
# The KspHacks project is in the India data center, where AutoML is unavailable.
AUTOML_MODEL_ID=

# This public Function URL is embedded in the frontend at build time.
NEXT_PUBLIC_AI_FN_URL=https://YOUR_PROJECT.catalystserverless.in/server/ai_quickml/
