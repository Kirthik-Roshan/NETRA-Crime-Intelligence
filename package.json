{
  "name": "netra-crime-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "NETRA — AI Crime Investigation Intelligence Platform for Karnataka State Police (Datathon 2026).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-login-statistics.mjs && next build && node scripts/prepare-slate.mjs",
    "build:catalyst": "node scripts/build-login-statistics.mjs && CATALYST_WEB_CLIENT=true next build && CATALYST_WEB_CLIENT=true node scripts/prepare-slate.mjs",
    "deploy:catalyst": "npm run build:catalyst && catalyst deploy --only functions:ai_quickml,client",
    "start": "next start",
    "lint": "next lint",
    "cloudscale:export": "node scripts/export-cloudscale-csv.mjs",
    "evidence:test": "node scripts/test-evidence-workflows.mjs",
    "vehicle-link:test": "node scripts/test-vehicle-evidence-link.mjs",
    "cctv:test": "node scripts/test-cctv-workflow.mjs",
    "voice:test": "node scripts/test-voice-workflow.mjs",
    "profiles:build": "node scripts/build-profile-assets.mjs",
    "profiles:test": "node scripts/test-profile-assets.mjs",
    "dossiers": "node scripts/gen-case-dossiers.mjs",
    "seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/seed.mjs --reset",
    "schema:audit": "node scripts/audit-er-schema.mjs",
    "read-model:test": "node scripts/test-ksp-read-model.mjs",
    "assistant:test": "node scripts/test-assistant-grounding.mjs",
    "assistant-analysis:test": "node scripts/test-assistant-analysis.mjs",
    "assistant-analysis:ui": "node scripts/test-assistant-analysis-ui.cjs",
    "documents:test": "node scripts/test-document-library.mjs",
    "analysis-stream:test": "node scripts/test-analysis-stream.mjs",
    "i18n:test": "node scripts/test-kannada-ui.mjs",
    "i18n:ui": "node scripts/test-kannada-workspace-ui.cjs",
    "case-journal:test": "node scripts/test-case-journal.mjs",
    "investigations:test": "node scripts/test-investigations.mjs && node scripts/test-investigation-alert-client.mjs",
    "investigations:ui": "node scripts/test-investigations-ui.cjs",
    "routes:test": "node scripts/test-static-routes.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:live": "node scripts/test-live-release.mjs",
    "catalyst:check": "node scripts/catalyst-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.436.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
